# Cloudflare static-asset headers (OpenNext deploy, docs/deploy-cloudflare.md).

# Hashed build output never changes: cache it for a year.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Project and team images are regenerated in place by scripts/: cache a week, then revalidate.
/projects/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

/team/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
